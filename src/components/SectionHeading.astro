---
interface Props {
  title: string;
  subtitle?: string;
  align?: "center" | "left";
}
const { title, subtitle, align = "center" } = Astro.props;
---

<div class:list={["mb-10", align === "center" ? "text-center" : "text-left"]}>
  <h2 class="text-3xl font-bold sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-3 text-muted">{subtitle}</p>}
  <span
    class:list={[
      "mt-4 block h-1 w-16 rounded bg-accent",
      align === "center" && "mx-auto",
    ]}
  ></span>
</div>
