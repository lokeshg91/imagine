---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageTitle from "../components/PageTitle.astro";
import GalleryGrid from "../components/GalleryGrid.tsx";
import { asset } from "../lib/images";

const clippingCount = 19;
const clippings = await Promise.all(
  Array.from({ length: clippingCount }, (_, i) => i + 1).map(async (n) => ({
    src: (await getImage({ src: asset(`media/clipping-${n}.png`), width: 900 })).src,
    alt: `Press clipping ${n} — Imagine Photojournalist Society`,
  })),
);
---

<Layout title="Press" description="Media highlights and press coverage of the Imagine Photojournalist Society.">
  <PageTitle
    title="Media Highlights and Press Coverage"
    subtitle="Discover our media presence through a collection of newspaper clippings showcasing key milestones and achievements."
  />
  <section class="container-page py-16">
    <GalleryGrid client:visible images={clippings} />
  </section>
</Layout>
